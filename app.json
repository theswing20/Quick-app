{
  "expo": {
    "name": "quick-app",
    "slug": "quick-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/shared/assets/app-icons/app-icon.png",
    "scheme": "quickapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.theswing20.quickapp",
      "associatedDomains": [
        "applinks:steady-rodent-14.clerk.accounts.dev",
        "webcredentials:steady-rodent-14.clerk.accounts.dev",
        "applinks:steady-rodent-14.clerk.accounts.dev",
        "webcredentials:steady-rodent-14.clerk.accounts.dev",
        "applinks:steady-rodent-14.clerk.accounts.dev",
        "webcredentials:steady-rodent-14.clerk.accounts.dev",
        "applinks:steady-rodent-14.clerk.accounts.dev",
        "webcredentials:steady-rodent-14.clerk.accounts.dev"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "We need access to your location to show you on the map and provide location-based services",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "We need access to your location to show you on the map and provide location-based services",
        "NSLocationAlwaysUsageDescription": "We need access to your location to show you on the map and provide location-based services",
        "NSCameraUsageDescription": "We need access to your camera to scan QR codes"
      },
      "entitlements": {
        "aps-environment": "production"
      },
      "appleTeamId": "5CX5962FS7"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FACA16",
        "foregroundImage": "./src/shared/assets/app-icons/app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.theswing20.quickapp",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/shared/assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": true
        }
      ],
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/shared/assets/app-icons/app-splash-screen.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FACA16",
          "dark": {
            "backgroundColor": "#FACA16"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/shared/assets/app-icons/app-icon.png",
          "color": "#FACA16",
          "sounds": []
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "We need access to your location to show you on the map and provide location-based services"
        }
      ],
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyBmpO6rOZcVDm9UYSmchGbND7JuRfLhLiw",
          "iosGoogleMapsApiKey": "AIzaSyBmpO6rOZcVDm9UYSmchGbND7JuRfLhLiw"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "We need access to your camera to scan QR codes"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "6b0d3559-6fe9-4180-b7a7-ac70d04c0843"
      }
    },
    "owner": "theswing20"
  }
}
